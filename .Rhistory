library(rstan)
library(ggplot2)
library(GGally)
# 1. Extract posterior samples
# Dimensions typically: Se_y = [n_draws, 77, n_years], lambda_base_ys = [n_draws, 13, n_years]
post <- extract(fit, pars = c("Se_y", "lambda_base_ys"))
Se_y_draws <- post$Se_y          # Dim: [draws, 77, years]
lambda_draws <- post$lambda_base_ys # Dim: [draws, 13, years]
region_id <- stan_data$region_id  # Vector of length 77
n_years <- dim(Se_y_draws)[3]
for (y in 1:n_years) {
# Choose province 1 (change 'p' if you want a different province)
p <- 1
reg <- region_id[p]
# Create a data frame of posterior draws for year y
df_year <- data.frame(
Se_y = Se_y_draws[, p, y],
lambda_base_ys = lambda_draws[, reg, y]
)
colnames(df_year) <- c(paste0("Se_y (Prov ", p, ", Yr ", y, ")"),
paste0("lambda_base_ys (Reg ", reg, ", Yr ", y, ")"))
# Generate pairs plot using GGally
p_plot <- ggpairs(df_year,
title = paste("Posterior Correlation - Year", y,
"(Province", p, "-> Region", reg, ")"),
lower = list(continuous = wrap("points", alpha = 0.3, size = 0.8)),
diag = list(continuous = wrap("densityDiag"))) +
theme_minimal()
print(p_plot)
# Optional: Save plots to disk
# ggsave(filename = paste0("posterior_pairs_year_", y, ".png"), plot = p_plot, width = 6, height = 6)
}
library(rstan)
library(tidyverse)
# 1. Extract posterior samples
post <- rstan::extract(fit, pars = c("Se_y", "lambda_base_ys"))
Se_y_draws <- post$Se_y             # Dim: [draws, 77, years]
lambda_draws <- post$lambda_base_ys # Dim: [draws, 13, years]
n_draws <- dim(Se_y_draws)[1]
n_prov <- 77
n_years <- dim(Se_y_draws)[3]
region_id <- stan_data$region_id
# 2. Build a tidy data frame for all provinces, years, and a subset of draws (e.g., 200 draws for speed)
set.seed(42)
draw_sample <- sample(n_draws, min(200, n_draws))
df_list <- list()
for (y in 1:n_years) {
for (p in 1:n_prov) {
reg <- region_id[p]
df_list[[length(df_list) + 1]] <- data.frame(
draw = 1:length(draw_sample),
province = factor(p),
region = factor(reg),
year = y,
Se_y = Se_y_draws[draw_sample, p, y],
lambda_base_ys = lambda_draws[draw_sample, reg, y]
)
}
library(rstan)
library(tidyverse)
# 1. Extract posterior samples
post <- rstan::extract(fit, pars = c("Se_y", "lambda_base_ys"))
Se_y_raw <- post$Se_y
lambda_raw <- post$lambda_base_ys
# Inspect dimensions to see the order
print(paste("Se_y dims:", paste(dim(Se_y_raw), collapse = ", ")))
print(paste("Lambda dims:", paste(dim(lambda_raw), collapse = ", ")))
n_draws <- dim(Se_y_raw)[1]
n_prov <- 77
n_regions <- dim(lambda_raw)[2]
n_years <- dim(Se_y_raw)[3] # Note: If your output dims are [draws, years, 77], change indices below accordingly
region_id <- stan_data$region_id
# 2. Build a tidy data frame safely using dynamic dimension indexing
set.seed(42)
draw_sample <- sample(n_draws, min(200, n_draws))
df_list <- list()
for (y in 1:n_years) {
for (p in 1:n_prov) {
reg <- region_id[p]
# NOTE: If dim(Se_y_raw) is [draws, years, 77] instead of [draws, 77, years],
# swap the indices to [draw_sample, y, p]
df_list[[length(df_list) + 1]] <- data.frame(
draw = 1:length(draw_sample),
province = factor(p),
region = factor(reg),
year = y,
Se_y = Se_y_raw[draw_sample, p, y],          # Adjust if dims are flipped
lambda_base_ys = lambda_raw[draw_sample, reg, y] # Adjust if dims are flipped
)
}
df_all <- bind_rows(df_list)
# 3. Plot: 1 Figure per Year, faceted by Region
for (y in 1:n_years) {
p_year <- df_all %>%
filter(year == y) %>%
ggplot(aes(x = lambda_base_ys, y = Se_y, color = province)) +
geom_point(alpha = 0.4, size = 1) +
facet_wrap(~ region, scales = "free") +
labs(
title = paste("Posterior Relationship by Region - Year", y),
subtitle = "Points represent posterior draws for provinces within each region",
x = "Region Lambda (lambda_base_ys)",
y = "Province Sensitivity (Se_y)"
) +
theme_minimal() +
theme(legend.position = "none")
print(p_year)
}
