# Define the decision tree structure
# Create nodes for each decision and chance event
decision_node <- DecisionNode$new("Marriage")
chance_node_pregnancy <- ChanceNode$new("Pregnancy", c(0.8, 0.2), c("Pregnant", "Not Pregnant"))
# Load the rdecision package
library(rdecision)
# Define the decision tree structure
# Create nodes for each decision and chance event
decision_node <- DecisionNode$new("Marriage")
chance_node_pregnancy <- ChanceNode$new("Pregnancy", outcomes = c("Pregnant", "Not Pregnant"), probs = c(0.8, 0.2))
library(rdecision)
cost_diet <- 50.0
cost_exercise <- 750.0
cost_stent <- 5000.0
decision_node <- DecisionNode$new("Programme")
decision_node
chance_node_diet <- ChanceNode$new("Outcome")
chance_node_exercise <- ChanceNode$new("Outcome")
leaf_node_diet_no_stent <- LeafNode$new("No intervention")
leaf_node_diet_stent <- LeafNode$new("Intervention")
leaf_node_exercise_no_stent <- LeafNode$new("No intervention")
leaf_node_exercise_stent <- LeafNode$new("Intervention")
action_diet <- Action$new(
decision_node, chance_node_diet, cost = cost_diet, label = "Diet"
)
action_diet
action_exercise <- Action$new(
decision_node, chance_node_exercise, cost = cost_exercise, label = "Exercise"
)
s_diet <- 12L
f_diet <- 56L
s_exercise <- 18L
f_exercise <- 40L
ip_diet <- f_diet / (s_diet + f_diet)
ip_exercise <- f_exercise / (s_exercise + f_exercise)
nnt <- 1.0 / (ip_diet - ip_exercise)
p_diet <- 1.0 - ip_diet
p_exercise <- 1.0 - ip_exercise
reaction_diet_success <- Reaction$new(
chance_node_diet, leaf_node_diet_no_stent,
p = p_diet, cost = 0.0, label = "Success"
)
reaction_diet_failure <- Reaction$new(
chance_node_diet, leaf_node_diet_stent,
p = NA_real_, cost = cost_stent, label = "Failure"
)
reaction_exercise_success <- Reaction$new(
chance_node_exercise, leaf_node_exercise_no_stent,
p = p_exercise, cost = 0.0, label = "Success"
)
reaction_exercise_failure <- Reaction$new(
chance_node_exercise, leaf_node_exercise_stent,
p = NA_real_, cost = cost_stent, label = "Failure"
)
reaction_diet_success
dt <- DecisionTree$new(
V = list(
decision_node,
chance_node_diet,
chance_node_exercise,
leaf_node_diet_no_stent,
leaf_node_diet_stent,
leaf_node_exercise_no_stent,
leaf_node_exercise_stent
),
E = list(
action_diet,
action_exercise,
reaction_diet_success,
reaction_diet_failure,
reaction_exercise_success,
reaction_exercise_failure
)
)
dt
dt$draw()
rs <- dt$evaluate()
rs
rp <- dt$evaluate(by = "path")
rp
du_stent <- 0.05
leaf_node_diet_stent$set_utility(1.0 - du_stent)
leaf_node_exercise_stent$set_utility(1.0 - du_stent)
rs <- dt$evaluate()
rs
example(stan_model, package = "rstan", run.dontrun = TRUE)
# | label: setup
# | include: false
library(here)
library(tidyverse)
library(rstan)
library(ggpubr)
library(scales)
library(knitr)
library(sf)
library(scales)
library(ggrepel)
library(ggspatial)
library(ggh4x)
library(cowplot)
library(patchwork)
library(biscale)
source(here("Scripts", "data_prep_functions.R"))
source(here("Scripts", "plot_functions.R"))
dataset <- "nFull"
case_data <- load_case_data()
case_age_data <- load_case_age_data()
population_data <- load_population_data()
sero_data <- load_sero_data()
map_data <- st_read(here("Analysis_data", "thailand_map.shp"))
# | label: data-config
# Define areas
if(dataset == "Full") {
area  <- case_data %>% distinct(Area) %>% pull(Area)
} else {
area  <- c("Chiang Rai", "Lampang",  "Nakhon Ratchasima", "Surin", "Songkhla", "Phatthalung", "Uttaradit", "Tak")
}
#
# Time period
start_year <- 2003
end_year   <- 2024
n_periods  <- 4
# Seasonality
n_harmonics <- 3
# Serology survey years (Gonwong et al. 2022)
sero_years <- c(2007, 2008, 2012)
# Fixed epidemiological parameters
omega <- 1/(22.3/12)      # per year, average duration of immunity (22.3 months)
nu <- 0.15                # clinical sign probability
sigma_lambda_0 <- 0.1     # baseline FOI variation
sigma_lambda_y <- 0.122   # year-to-year FOI variation
sigma_lambda_init <- 0.75 # initial FOI variation
# Reference age group for susceptibility normalization
ref_age_label <- "25 to 35"
age_levels <- c("0 to 5", "5 to 15", "15 to 25", "25 to 35",
"35 to 45", "45 to 55", "55 to 65", "above 65")
# Population age group mapping (raw -> standardized)
pop_age_levels = c("0 to 4", "5 to 14", "15 to 24", "25 to 34",
"35 to 44", "45 to 54", "55 to 64", "above 65")
# Serology age group
sero_age <- 3
config <- list(
areas = area,
start_year = start_year,
end_year = end_year,
n_periods = n_periods,
n_harmonics = n_harmonics,
sero_years = sero_years,
omega = omega,
nu = nu,
sigma_lambda_0 = sigma_lambda_0,
sigma_lambda_y = sigma_lambda_y,
sigma_lambda_init = sigma_lambda_init,
ref_age_label = ref_age_label,
age_levels = age_levels,
pop_age_levels = pop_age_levels
)
data <- prepare_stan_data(config)
stan_data <- data$stan_data
stan_data$sero_age <- sero_age  # Add serology age group to stan_data
calendar <- data$calendar
site_levels <- data$site_levels
region_levels <- data$region_levels
age_levels <- data$age_levels
# Save prepared data
save(
stan_data, calendar, site_levels, region_levels, age_levels,
file = here("Rout", paste("stan_data_", dataset, ".RData", sep = ""))
)
cat("Dimensions:\n")
cat(sprintf("  Provinces (S): %d\n", stan_data$S))
cat(sprintf("  Regions (R): %d\n", stan_data$R))
cat(sprintf("  Years (Y): %d\n", stan_data$Y))
cat(sprintf("  Months (T): %d\n", stan_data$T))
cat(sprintf("  Age groups (A): %d\n", stan_data$A))
cat(sprintf("  Periods (P): %d\n", stan_data$P))
cat(sprintf("  Harmonics (H): %d\n", stan_data$H))
model_settings <- data.frame(
iter = getOption("stan.iter", 2000),
warmup = getOption("stan.warmup", 1000),
chains = getOption("stan.chains", 4),
thin = getOption("stan.thin", 4),
seed = getOption("stan.seed", 124L)
)
model_file <-  "model10.stan"
save(model_settings, model_file, file = here("Rout", paste("model_settings_", dataset, ".RData", sep = "")))
seed <- 12
system(paste('Rscript --vanilla Scripts/run_models_local.R', dataset, seed))
setwd("~/Project/dynamite-506-analysis/Scripts")
